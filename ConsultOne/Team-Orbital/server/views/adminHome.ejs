<!DOCTYPE html>
<html>
<head>
    <title>MedApp Admin Dashboard</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">ConsultOne Admin Dashboard</h1>
        <p class="text-muted">Admin Control Panel</p>
    </div>

    <div class="row">

        <!-- Total Doctors -->
        <div class="col-md-3 mb-4">
            <div class="card shadow border-0">
                <div class="card-body text-center">
                    <h5 class="text-primary">Total Doctors</h5>
                    <h2><%= totalDoctors %></h2>
                    <a href="/admin/doctors" class="btn btn-primary mt-3">
                        View Doctors
                    </a>
                </div>
            </div>
        </div>

        <!-- Total Patients -->
        <div class="col-md-3 mb-4">
            <div class="card shadow border-0">
                <div class="card-body text-center">
                    <h5 class="text-success">Total Patients</h5>
                    <h2><%= totalPatients %></h2>
                    <a href="/admin/patients" class="btn btn-success mt-3">
                        View Patients
                    </a>
                </div>
            </div>
        </div>

        <!-- Patient Issues -->
        <div class="col-md-3 mb-4">
            <div class="card shadow border-0">
                <div class="card-body text-center">
                    <h5 class="text-warning">Total Patient Issues</h5>
                    <h2><%= totalIssues %></h2>
                    <a href="/admin/issues" class="btn btn-warning mt-3">
                        View Issues
                    </a>
                </div>
            </div>
        </div>

        <!-- Unverified Doctors -->
        <div class="col-md-3 mb-4">
            <div class="card shadow border-0">
                <div class="card-body text-center">
                    <h5 class="text-danger">Unverified Doctors</h5>
                    <h2><%= totalUnverifiedDoctors %></h2>
                    <a href="/admin/doctors/unverified" class="btn btn-danger mt-3">
                        Approve Doctors
                    </a>
                </div>
            </div>
        </div>

        <!-- Notification Card (UPDATED: opens notification page) -->
        <div class="col-md-3 mb-4">
            <div class="card shadow border-0">
                <div class="card-body text-center">

                    <h5 class="text-dark">Send Notification</h5>

                    <a href="/admin/notification" class="btn btn-dark mt-3">
                        Open Notification Page
                    </a>

                </div>
            </div>
        </div>

    </div>

</div>

</body>
</html>
